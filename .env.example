# ─────────────────────────────────────────────
# Database (MySQL / MariaDB)
# ─────────────────────────────────────────────
DATABASE_URL="mysql://user:password@host:3306/labs_itbd"
# Optional: override only the host without rewriting the whole URL
# DATABASE_HOST_OVERRIDE=

# ─────────────────────────────────────────────
# NextAuth (Auth.js v5)
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# In production set the canonical URL (omit in local dev)
# AUTH_URL="https://labs.example.com"

# ─────────────────────────────────────────────
# Microsoft Entra ID (Azure AD) SSO — the only auth provider
# ─────────────────────────────────────────────
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
# Optional overrides
# AZURE_AD_AUTHORITY=
# AZURE_AD_GRAPH_SCOPES="openid profile email offline_access User.Read"
# AZURE_AD_PROMPT="consent"

# Comma-separated extra whitelists (merged with built-in defaults)
# DEVADMIN_WHITELIST_EMAILS="a@itbd.net,b@itbd.net"
# EXECUTIVE_WHITELIST_EMAILS=""

# ─────────────────────────────────────────────
# OpenAI (interview evaluation + email assessment scoring)
# ─────────────────────────────────────────────
OPENAI_API_KEY=""
# Optional model overrides
# OPENAI_EVALUATION_MODEL="gpt-4o-mini"
# AI_FAST_MODEL="gpt-4o-mini"
# OPENAI_TRANSCRIPTION_MODEL="whisper-1"
# Optional cost tracking (cents per 1M tokens)
# OPENAI_INPUT_COST_PER_1M_TOKENS_CENTS=15
# OPENAI_OUTPUT_COST_PER_1M_TOKENS_CENTS=60

# ─────────────────────────────────────────────
# Deepgram (primary audio transcription; falls back to OpenAI Whisper)
# ─────────────────────────────────────────────
DEEPGRAM_API_KEY=""
# Force Whisper instead of Deepgram by setting:
# TRANSCRIPTION_PROVIDER="openai"

# ─────────────────────────────────────────────
# Uploads (managed file storage; lives one level above the app root)
# ─────────────────────────────────────────────
# UPLOADS_ROOT="../uploads-storage"

# ─────────────────────────────────────────────
# Interview module tuning (optional)
# ─────────────────────────────────────────────
# INTERVIEW_AUDIO_RETENTION_DAYS=30
# INTERVIEW_AUDIO_ROOT="/uploads/interview-audio"
# INTERVIEW_EVALUATION_MODEL="gpt-4o-mini"
